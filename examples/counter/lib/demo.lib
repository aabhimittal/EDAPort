/* Tiny demo liberty: areas in um^2, enough for yosys dfflibmap/abc mapping. Not a real PDK. */
library(demo) {
  delay_model : table_lookup;
  time_unit : "1ns";
  area : 1;
  cell(INV) { area: 1.0; pin(A) { direction: input; } pin(Y) { direction: output; function: "A'"; } }
  cell(BUF) { area: 1.5; pin(A) { direction: input; } pin(Y) { direction: output; function: "A"; } }
  cell(NAND2) { area: 1.5; pin(A) { direction: input; } pin(B) { direction: input; } pin(Y) { direction: output; function: "(A*B)'"; } }
  cell(NOR2) { area: 1.5; pin(A) { direction: input; } pin(B) { direction: input; } pin(Y) { direction: output; function: "(A+B)'"; } }
  cell(AND2) { area: 2.0; pin(A) { direction: input; } pin(B) { direction: input; } pin(Y) { direction: output; function: "(A*B)"; } }
  cell(OR2) { area: 2.0; pin(A) { direction: input; } pin(B) { direction: input; } pin(Y) { direction: output; function: "(A+B)"; } }
  cell(XOR2) { area: 3.0; pin(A) { direction: input; } pin(B) { direction: input; } pin(Y) { direction: output; function: "(A^B)"; } }
  cell(DFF) {
    area: 6.0;
    ff(IQ, IQN) { clocked_on: C; next_state: D; }
    pin(C) { direction: input; clock: true; }
    pin(D) { direction: input; }
    pin(Q) { direction: output; function: "IQ"; }
  }
}
